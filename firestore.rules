rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['marjoriebrinella@gmail.com', 'mjcontrolsystems@gmail.com'];
    }

    function ordenValida(d) {
      return d.clienta is string && d.clienta.size() > 0 && d.clienta.size() <= 80
        && d.telefono is string && d.telefono.size() <= 20
        && d.evento is string && d.evento.size() <= 40
        && d.lugar is string && d.lugar.size() <= 60
        && d.fecha is string && d.fecha.size() <= 10
        && d.hora is string && d.hora.size() <= 5
        && d.lineas is list && d.lineas.size() > 0 && d.lineas.size() <= 50
        && d.nombres is list && d.nombres.size() <= 200
        && d.nota is string && d.nota.size() <= 300
        && d.total is number && d.domicilio is number && d.anticipo is number
        && d.clientaPrimera is bool
        && d.numero is string && d.numero.matches('^BR-[0-9]{4,6}$');
    }

    match /ordenes/{id} {
      allow read, delete: if autorizado();
      allow create: if autorizado() && ordenValida(request.resource.data);
      allow update: if autorizado() && ordenValida(request.resource.data)
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.creada == resource.data.creada;
    }

    match /contadores/ordenes {
      allow read: if autorizado();
      allow write: if autorizado()
        && request.resource.data.keys().hasOnly(['siguiente'])
        && request.resource.data.siguiente is int;
    }

    // Servicios y precios sugeridos (pestaña Precios).
    match /config/servicios {
      allow read: if autorizado();
      allow write: if autorizado()
        && request.resource.data.lista is list
        && request.resource.data.lista.size() <= 60;
    }

    // Solicitudes de cita desde la página pública: cualquiera puede CREAR una
    // (con datos limitados); solo la dueña puede verlas, cambiarlas o borrarlas.
    match /solicitudes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'telefono', 'servicio', 'fecha', 'mensaje', 'creada', 'estado', 'notificada', 'origen'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string && request.resource.data.telefono.size() >= 8 && request.resource.data.telefono.size() <= 20
        && request.resource.data.servicio is string && request.resource.data.servicio.size() <= 60
        && request.resource.data.fecha is string && request.resource.data.fecha.size() <= 10
        && request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 500
        && request.resource.data.origen == 'web'
        && request.resource.data.estado == 'nueva'
        && request.resource.data.notificada == false
        && request.resource.data.creada == request.time;
      allow read, update, delete: if autorizado();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
